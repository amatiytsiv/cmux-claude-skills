#!/usr/bin/env zsh
# cmux-skills: layout for Claude skill / plugin development
# +-------------------+----------+
# | Claude (70%)      | ls / grep|
# |  skill design     | files    |
# +-------------------+----------+
#
# Usage: cmux-skills [skills-directory]  (default: ~/.claude)

set -euo pipefail

if ! command -v cmux &>/dev/null; then
  echo "Error: cmux CLI not found. Make sure cmux.app is installed."
  exit 1
fi

if [[ -z "${CMUX_WORKSPACE_ID:-}" ]]; then
  echo "Error: must be run inside a cmux workspace terminal."
  exit 1
fi

CURRENT_PANES=$(cmux list-panes 2>/dev/null | grep -cE "pane:[0-9]+" || true)
if [[ "$CURRENT_PANES" -gt 1 ]]; then
  echo "Already has $CURRENT_PANES panes."
  exit 1
fi

SKILLS_DIR="${1:-$HOME/.claude}"
echo "Setting up skill-development layout... ($SKILLS_DIR)"

if [[ ! -d "$SKILLS_DIR" ]]; then
  echo "Warning: directory does not exist: $SKILLS_DIR"
fi

SKILLS_DIR_Q=$(printf '%q' "$SKILLS_DIR")

# Right side: file-explorer pane
RT_OUT=$(cmux new-pane --direction right)
RT_SURFACE=$(echo "$RT_OUT" | grep -oE "surface:[0-9]+" | head -1)
if [[ -z "$RT_SURFACE" ]]; then
  echo "Error: could not identify right-pane surface ID."
  exit 1
fi
cmux send --surface "$RT_SURFACE" "cd $SKILLS_DIR_Q && ls -la"$'\n'

cmux set-status layout "skills+nav" --icon "wand.and.stars" --color "#6A1B9A"
echo "Done. The right pane opens at the skills directory."
