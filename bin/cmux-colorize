#!/usr/bin/env zsh
# cmux-colorize: change terminal background color per pane group (ANSI OSC 11)
#
# How it works:
#   Classifies each pane's surfaces by topic (work/research/tools),
#   then sends 'printf \033]11;#color\007' to the first shell surface in each pane.
#
# ⚠️  Note: only works on surfaces at a shell prompt.
#           Surfaces running Claude/Python REPL etc. are skipped.
#
# Usage: cmux-colorize [workspace-ref]
#
# Environment variables:
#   CMUX_COLOR_WORK      Work pane background color (default: #0d1117)
#   CMUX_COLOR_RESEARCH  Research pane background color (default: #0a1628)
#   CMUX_COLOR_TOOLS     Tools pane background color (default: #1a0d28)
#   CMUX_RESEARCH_KEYWORDS  Research classification keywords (pipe-separated regex)
#   CMUX_TOOLS_KEYWORDS     Tools classification keywords (pipe-separated regex)

set -euo pipefail

if ! command -v cmux &>/dev/null; then
  echo "Error: cmux CLI not found. Make sure cmux.app is installed."
  exit 1
fi

WORKSPACE="${1:-${CMUX_WORKSPACE_ID:-}}"
if [[ -z "$WORKSPACE" ]]; then
  echo "Usage: cmux-colorize [workspace-ref]"
  echo "  Or run from inside a cmux workspace terminal (CMUX_WORKSPACE_ID is set automatically)."
  exit 1
fi

# ── Color settings ──────────────────────────────────────────
COLOR_WORK="${CMUX_COLOR_WORK:-#0d1117}"
COLOR_RESEARCH="${CMUX_COLOR_RESEARCH:-#0a1628}"
COLOR_TOOLS="${CMUX_COLOR_TOOLS:-#1a0d28}"

# ── Classification patterns ────────────────────────────────
_RESEARCH_PAT="${CMUX_RESEARCH_KEYWORDS:-research|deep.dive|survey|analysis|reference|docs|learn}"
_TOOLS_PAT="${CMUX_TOOLS_KEYWORDS:-skill|rule|obsidian|kaizen|consistency|hook|plugin|setup|n8n|claude|hud|memory|tool}"

classify_surface() {
  local title
  title=$(echo "$1" | tr '[:upper:]' '[:lower:]')
  if echo "$title" | grep -qE "$_RESEARCH_PAT"; then
    echo "research"
  elif echo "$title" | grep -qE "$_TOOLS_PAT"; then
    echo "tools"
  else
    echo "work"
  fi
}

# Detect running Claude (✳ ⠂ ⠐ prefix)
is_claude_running() {
  echo "$1" | grep -qE "^[✳⠂⠐]"
}

apply_color() {
  local surface=$1 color=$2
  # OSC 11: change terminal background color. Runs printf command in the shell.
  local err
  err=$(cmux send --surface "$surface" "printf '\\033]11;${color}\\007'"$'\n' 2>&1) || {
    echo "  Warning: failed to send to $surface — $err"
    return 0
  }
}

echo "=== cmux-colorize: $WORKSPACE ==="

while IFS= read -r pane_line; do
  PANE=$(echo "$pane_line" | grep -oE "pane:[0-9]+" | head -1)
  [[ -z "$PANE" ]] && continue

  # Collect surfaces in this pane and classify them
  declare -a GROUPS=()
  SHELL_SURFACE=""   # surface at shell prompt (not running Claude)

  while IFS= read -r surf_line; do
    [[ -z "$surf_line" ]] && continue
    SURFACE=$(echo "$surf_line" | grep -oE "surface:[0-9]+" | head -1)
    [[ -z "$SURFACE" ]] && continue
    TITLE=$(echo "$surf_line" | sed -E 's/[* ]*(surface:[0-9]+)[[:space:]]*//' \
            | sed 's/\[selected\]//' | xargs)

    GROUPS+=("$(classify_surface "$TITLE")")

    # Skip [selected] surfaces and surfaces running Claude
    local is_selected=false
    echo "$surf_line" | grep -q "\[selected\]" && is_selected=true

    if [[ -z "$SHELL_SURFACE" ]] && [[ "$is_selected" == false ]] && ! is_claude_running "$TITLE"; then
      SHELL_SURFACE="$SURFACE"
    fi
  done < <(cmux list-pane-surfaces --workspace "$WORKSPACE" --pane "$PANE" 2>/dev/null)

  [[ ${#GROUPS[@]} -eq 0 ]] && continue

  # Determine pane group by majority vote
  local_work=$(printf '%s\n' "${GROUPS[@]}" | grep -c "^work$" || true)
  local_research=$(printf '%s\n' "${GROUPS[@]}" | grep -c "^research$" || true)
  local_tools=$(printf '%s\n' "${GROUPS[@]}" | grep -c "^tools$" || true)

  if [[ $local_research -gt $local_work && $local_research -gt $local_tools ]]; then
    PANE_GROUP="research"; COLOR="$COLOR_RESEARCH"
  elif [[ $local_tools -gt $local_work ]]; then
    PANE_GROUP="tools";    COLOR="$COLOR_TOOLS"
  else
    PANE_GROUP="work";     COLOR="$COLOR_WORK"
  fi

  if [[ -n "$SHELL_SURFACE" ]]; then
    printf "  %-12s → [%-8s] %s\n" "$PANE" "$PANE_GROUP" "$COLOR"
    apply_color "$SHELL_SURFACE" "$COLOR"
    sleep 0.1
  else
    printf "  %-12s → [%-8s] %s  (skipped: all surfaces are running)\n" "$PANE" "$PANE_GROUP" "$COLOR"
  fi

  unset GROUPS SHELL_SURFACE
done < <(cmux list-panes --workspace "$WORKSPACE" 2>/dev/null | grep "pane:")

echo ""
echo "Done. Panes without color applied have no surface at a shell prompt."
echo "  Customize colors: CMUX_COLOR_WORK / CMUX_COLOR_RESEARCH / CMUX_COLOR_TOOLS"
