#!/usr/bin/env zsh
# cmux-day-start: bulk-create all your daily workspaces at once
# Usage: cmux-day-start
# Workspaces that already exist are skipped.
#
# ────────────────────────────────────────────────────────────
# This file is an example template. Copy it, edit it to point
# at your own project paths, and save as ~/.local/bin/cmux-day-start.
# ────────────────────────────────────────────────────────────

set -euo pipefail

if ! command -v cmux &>/dev/null; then
  echo "Error: cmux CLI not found."
  exit 1
fi

# ── User settings (edit these) ───────────────────────────────
# Project root directory
PROJECTS_ROOT="$HOME/projects"

# Each workspace: (name, directory, layout-command)
# Layout commands: cmux-ios, cmux-n8n, cmux-data, cmux-skills, cmux-web
# ─────────────────────────────────────────────────────────────

workspace_exists() {
  cmux list-workspaces 2>/dev/null | grep -qE "[[:space:]]${1}([[:space:]]|$)"
}

create_ws() {
  local name=$1
  local dir=$2
  local cmd=$3

  if workspace_exists "$name"; then
    echo "✓ '$name' already exists, skipping"
    return
  fi

  if [[ ! -d "$dir" ]]; then
    echo "Warning: directory not found, skipping → $dir"
    return
  fi

  echo "→ creating '$name'..."
  local REF
  REF=$(cmux new-workspace --cwd "$dir" --command "$cmd" | grep -oE "workspace:[0-9]+" | head -1 || true)
  sleep "${CMUX_INIT_DELAY:-0.4}"
  [[ -n "$REF" ]] && cmux rename-workspace --workspace "$REF" "$name" 2>/dev/null && echo "  done: $name"
}

echo "==============================="
echo "  cmux day-start"
echo "==============================="

# Example workspaces — edit to match your projects
create_ws "ios-app"      "$PROJECTS_ROOT/ios-app"      "cmux-ios \"$PROJECTS_ROOT/ios-app\" && claude"
create_ws "api-server"   "$PROJECTS_ROOT/api-server"   "cmux-web \"$PROJECTS_ROOT/api-server\" \"npm run dev\" && claude"
create_ws "data-science" "$PROJECTS_ROOT/data"          "cmux-data && claude"
create_ws "my-skills"    "$HOME/.claude"                "cmux-skills && claude"
create_ws "automation"   "$PROJECTS_ROOT/automation"    "cmux-n8n && claude"

echo ""
echo "==============================="
cmux list-workspaces
echo "==============================="
echo "day-start complete!"
