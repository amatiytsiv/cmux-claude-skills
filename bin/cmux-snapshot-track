#!/usr/bin/env python3
"""cmux-snapshot-track: Claude SessionStart hook
  → Appends (CMUX_SURFACE_ID, sessionId, cwd, ts) to ~/.cmux-snapshots/session-map.jsonl.

Persistently records panel UUID ↔ sessionId mappings every time a Claude Code session
starts within a cmux environment. This allows cmux-snapshot to use accurate mappings
even for dead sessions.

Installation: add to ~/.claude/settings.json hooks.SessionStart:
  {
    "hooks": {
      "SessionStart": [
        {
          "matcher": "",
          "hooks": [
            { "type": "command", "command": "<install-path>/cmux-snapshot-track" }
          ]
        }
      ]
    }
  }

Environment variables:
  CMUX_SNAPSHOT_DIR  Snapshot directory. Default ~/.cmux-snapshots
"""

import json
import os
import sys
from datetime import datetime, timezone
from pathlib import Path

SNAPSHOT_DIR = Path(os.environ.get("CMUX_SNAPSHOT_DIR", str(Path.home() / ".cmux-snapshots")))
OUT = SNAPSHOT_DIR / "session-map.jsonl"


def main() -> None:
    """Graceful exit 0 on all edge cases — hook must never block Claude Code."""
    panel = os.environ.get("CMUX_SURFACE_ID")
    if not panel:
        return  # not in a cmux environment — silent skip

    sid = None
    try:
        data = json.load(sys.stdin)
        sid = data.get("session_id") or data.get("sessionId")
    except (json.JSONDecodeError, ValueError, OSError):
        pass
    if not sid:
        return  # no session_id — silent skip

    try:
        SNAPSHOT_DIR.mkdir(exist_ok=True)
        rec = {
            "ts": datetime.now(timezone.utc).isoformat(timespec="seconds"),
            "panel": panel,
            "session": sid,
            "cwd": os.environ.get("PWD", ""),
            "ws": os.environ.get("CMUX_WORKSPACE_ID", ""),
        }
        with open(OUT, "a") as f:
            f.write(json.dumps(rec) + "\n")
    except OSError:
        return  # disk error — silent skip


if __name__ == "__main__":
    main()
