#!/usr/bin/env zsh
# cmux-web: web-frontend layout (Claude on the left + dev server on the right)
# +-------------------+----------+
# | Claude (70%)      | dev      |
# |                   | server   |
# +-------------------+----------+
#
# Usage: cmux-web [project-directory] [dev-command]
#   default dev command: $CMUX_WEB_DEV_CMD or "npm run dev"
#   e.g. cmux-web ~/myproject "npm run dev"
#        CMUX_WEB_DEV_CMD="yarn dev" cmux-web ~/myproject
#
# NOTE: DEV_CMD is treated as a trusted argument from the caller.
#       Do NOT forward DEV_CMD from external input or shared scripts.

set -euo pipefail

if ! command -v cmux &>/dev/null; then
  echo "Error: cmux CLI not found. Make sure cmux.app is installed."
  exit 1
fi

if [[ -z "${CMUX_WORKSPACE_ID:-}" ]]; then
  echo "Error: must be run inside a cmux workspace terminal."
  exit 1
fi

CURRENT_PANES=$(cmux list-panes 2>/dev/null | grep -cE "pane:[0-9]+" || true)
if [[ "$CURRENT_PANES" -gt 1 ]]; then
  echo "Already has $CURRENT_PANES panes."
  exit 1
fi

PROJECT_DIR="${1:-$PWD}"
# Default dev command: CMUX_WEB_DEV_CMD env var → arg 2 → "npm run dev"
DEV_CMD="${2:-${CMUX_WEB_DEV_CMD:-npm run dev}}"
echo "Setting up web-development layout... ($PROJECT_DIR)"

if [[ ! -d "$PROJECT_DIR" ]]; then
  echo "Warning: directory does not exist: $PROJECT_DIR"
fi

PROJECT_DIR_Q=$(printf '%q' "$PROJECT_DIR")

# Right side: dev-server pane
RT_OUT=$(cmux new-pane --direction right)
RT_SURFACE=$(echo "$RT_OUT" | grep -oE "surface:[0-9]+" | head -1)
if [[ -z "$RT_SURFACE" ]]; then
  echo "Error: could not identify right-pane surface ID."
  exit 1
fi
# DEV_CMD is intentionally unquoted — caller-trusted command
cmux send --surface "$RT_SURFACE" "cd $PROJECT_DIR_Q && $DEV_CMD"$'\n'

cmux set-status layout "web+devserver" --icon "globe" --color "#00695C"
echo "Done. The right pane starts: '$DEV_CMD'."
