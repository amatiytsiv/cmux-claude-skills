#!/usr/bin/env python3
"""cmux-restore: restore a cmux layout + Claude sessions from a snapshot
Usage: cmux-restore [snapshot-name-or-path]
       no argument → use the latest snapshot

Environment variables:
  CMUX_SNAPSHOT_DIR     Snapshot directory. Default ~/.cmux-snapshots
  CMUX_CLAUDE_PROJECTS  Claude projects directory. Default ~/.claude/projects
  CMUX_RESTORE_DELAY    Delay in seconds between cmux commands. Default 0.3.
                        On slow machines, raise to 1.0+ if restoration fails.

Session restore branches (self-healing):
  1. Snapshot's session_id + full_path exists → claude --resume <sid>
  2. session_id present but no full_path (legacy) → verify via cwd estimation → resume
  3. Both stale + first_prompt available → re-search by first_prompt matching → resume with new sid
  4. All fail → claude -c (most-recent session fallback)
"""

import json
import os
import re
import sys
import subprocess
import time
from pathlib import Path

SNAPSHOT_DIR = Path(os.environ.get("CMUX_SNAPSHOT_DIR", str(Path.home() / ".cmux-snapshots")))
CLAUDE_PROJECTS = Path(os.environ.get("CMUX_CLAUDE_PROJECTS", str(Path.home() / ".claude/projects")))
RESTORE_DELAY = float(os.environ.get("CMUX_RESTORE_DELAY", "0.3"))

# Allowed pattern: cmux ref tokens (workspace:N, pane:N, surface:N)
_REF_RE = re.compile(r"^(workspace|pane|surface):\d+$")
_SESSION_ID_RE = re.compile(r"^[A-Za-z0-9_\-]{1,128}$")


def _validate_ref(value: str, label: str) -> str:
    """Validate a cmux ref token (workspace:N, pane:N, surface:N)."""
    if not _REF_RE.match(value):
        raise ValueError(f"unexpected {label} format: {value!r}")
    return value


def run(argv: list[str]) -> str:
    """Run a cmux command with shell=False — no shell injection."""
    r = subprocess.run(argv, capture_output=True, text=True)
    return r.stdout.strip()


def panes_now(ws_ref: str) -> set[str]:
    out = run(["cmux", "list-panes", "--workspace", ws_ref])
    return {tok for line in out.splitlines() for tok in line.split() if tok.startswith("pane:")}


def extract_ref(output: str, prefix: str) -> str | None:
    for tok in output.split():
        if tok.startswith(f"{prefix}:") and _REF_RE.match(tok):
            return tok
    return None


def project_dir_for(cwd: str) -> Path | None:
    """Convert cwd to ~/.claude/projects key (replace all non-alphanumeric with '-'). Returns Path only if it exists."""
    if not cwd:
        return None
    key = re.sub(r"[^A-Za-z0-9]+", "-", cwd)
    if not key.startswith("-"):
        key = "-" + key
    p = CLAUDE_PROJECTS / key
    return p if p.exists() else None


def extract_first_prompt(jsonl_path: Path) -> str:
    """Extract the first user text message from a jsonl (skips slash commands and <tag>-prefixed)."""
    try:
        with open(jsonl_path) as f:
            for line in f:
                try:
                    o = json.loads(line)
                except (json.JSONDecodeError, ValueError):
                    continue
                if o.get("type") != "user":
                    continue
                msg = o.get("message", {}).get("content", "")
                if isinstance(msg, list):
                    for c in msg:
                        if isinstance(c, dict) and c.get("type") == "text":
                            msg = c.get("text", "")
                            break
                    else:
                        continue
                if isinstance(msg, str) and msg and not msg.lstrip().startswith("<"):
                    return msg.strip()
    except OSError:
        pass
    return ""


def reresolve_session(cwd: str, first_prompt: str | None) -> str | None:
    """Find the most recent jsonl matching a first-prompt snippet and return its sessionId.

    Compares the first 80 chars (lowercased). Only scans *.jsonl within the CWD project.
    """
    proj = project_dir_for(cwd)
    if not proj or not first_prompt:
        return None
    snippet = first_prompt.strip()[:80].lower()
    if not snippet:
        return None
    candidates: list[tuple[float, str]] = []
    for fp in proj.glob("*.jsonl"):
        prompt = extract_first_prompt(fp).lower()
        if not prompt:
            continue
        if snippet in prompt or prompt[:80] == snippet:
            candidates.append((fp.stat().st_mtime, fp.stem))
    if not candidates:
        return None
    candidates.sort(reverse=True)
    return candidates[0][1]


def configure_surface(surf_ref: str, ws_ref: str, surface_data: dict) -> None:
    """Send cd + Claude session restoration commands to a surface.

    Self-healing branches:
      1) session_id + full_path exists → "ID match"
      2) session_id present, no full_path (legacy) → verify via cwd estimation → "ID match (legacy)"
      3) Stale + first_prompt → re-resolve to find new sid → "re-resolved"
      4) All fail → claude -c → "most-recent (fallback)"
    """
    d = surface_data.get("dir", "")
    is_claude = surface_data.get("is_claude", False)
    session_id = surface_data.get("session_id")
    full_path = surface_data.get("full_path")
    first_prompt = surface_data.get("first_prompt")
    title = surface_data.get("title", "")

    if d:
        # Pass argv as a list (no shlex) — safe for paths with spaces or special chars
        run(["cmux", "send", "--workspace", ws_ref, "--surface", surf_ref, f"cd {_shell_quote(d)}\n"])
        time.sleep(RESTORE_DELAY / 3)

    if is_claude:
        status: str | None = None

        # 1) Snapshot-stored ID — use only if file actually exists
        if session_id and _SESSION_ID_RE.match(session_id) and full_path and Path(full_path).exists():
            status = "ID match"
        elif session_id and _SESSION_ID_RE.match(session_id) and not full_path:
            # Legacy snapshot — no fullpath info, verify via cwd estimation
            proj = project_dir_for(d)
            if proj and (proj / f"{session_id}.jsonl").exists():
                status = "ID match (legacy)"
            else:
                session_id = None  # stale, proceed to re-resolution

        # 2) Stale ID → re-resolve via first_prompt matching
        if not status and first_prompt:
            new_sid = reresolve_session(d, first_prompt)
            if new_sid and _SESSION_ID_RE.match(new_sid):
                session_id = new_sid
                status = "re-resolved"

        if status:
            run(["cmux", "send", "--workspace", ws_ref, "--surface", surf_ref,
                 f"claude --resume {session_id}\n"])
        else:
            # 3) Last resort fallback: most recent session for this directory
            run(["cmux", "send", "--workspace", ws_ref, "--surface", surf_ref, "claude -c\n"])
            status = "most-recent (fallback)"
        time.sleep(RESTORE_DELAY)
        print(f"    Claude restored ({status}): {title[:40]}")
    else:
        print(f"    {title[:40]}")


def _shell_quote(s: str) -> str:
    """POSIX sh-safe quoting — equivalent to shlex.quote."""
    import shlex
    return shlex.quote(s)


def restore_node(node: dict, ws_ref: str, pane_ref: str, surf_ref: str) -> None:
    """Recursively restore a layout tree."""
    if node["type"] == "pane":
        surfaces = node.get("surfaces", [])
        if not surfaces:
            return
        configure_surface(surf_ref, ws_ref, surfaces[0])
        for surf_data in surfaces[1:]:
            out = run(["cmux", "new-surface", "--pane", pane_ref, "--workspace", ws_ref])
            new_surf = extract_ref(out, "surface")
            if new_surf:
                configure_surface(new_surf, ws_ref, surf_data)

    elif node["type"] == "split":
        direction = "right" if node.get("orientation", "horizontal") == "horizontal" else "down"

        before = panes_now(ws_ref)
        out = run(["cmux", "new-split", direction, "--workspace", ws_ref, "--surface", surf_ref])
        time.sleep(RESTORE_DELAY)
        after = panes_now(ws_ref)

        new_pane_set = after - before
        if len(new_pane_set) != 1:
            print(f"  Warning: failed to detect new pane after split (got {len(new_pane_set)})")
        new_pane = next(iter(new_pane_set), None)
        new_surf = extract_ref(out, "surface")

        restore_node(node["first"], ws_ref, pane_ref, surf_ref)
        if new_pane and new_surf:
            restore_node(node["second"], ws_ref, new_pane, new_surf)

    elif node["type"] == "unknown":
        print("  Warning: unknown node type, skipping.")


def restore_workspace(ws_data: dict) -> None:
    name = ws_data.get("name", "unnamed")
    cwd = ws_data.get("cwd") or str(Path.home())

    # Basic sanity check on name + path
    if not isinstance(name, str) or any(ord(c) < 0x20 for c in name):
        print(f"  Warning: invalid workspace name, skipping: {name!r}")
        return
    if not isinstance(cwd, str) or any(ord(c) < 0x20 for c in cwd):
        print(f"  Warning: invalid cwd, skipping")
        return

    print(f"\n→ restoring '{name}'... ({cwd})")
    out = run(["cmux", "new-workspace", "--cwd", cwd])
    ws_ref = extract_ref(out, "workspace")
    if not ws_ref:
        print("  ✗ failed to create workspace")
        return

    time.sleep(RESTORE_DELAY * 1.5)
    run(["cmux", "rename-workspace", "--workspace", ws_ref, name])

    panes_out = run(["cmux", "list-panes", "--workspace", ws_ref])
    first_pane = next(
        (tok for line in panes_out.splitlines() for tok in line.split() if tok.startswith("pane:")),
        None,
    )
    if not first_pane:
        print("  ✗ failed to identify initial pane")
        return

    surfs_out = run(["cmux", "list-pane-surfaces", "--workspace", ws_ref, "--pane", first_pane])
    first_surf = next(
        (tok for line in surfs_out.splitlines() for tok in line.split() if tok.startswith("surface:")),
        None,
    )
    if not first_surf:
        print("  ✗ failed to identify initial surface")
        return

    try:
        restore_node(ws_data["layout"], ws_ref, first_pane, first_surf)
    except Exception as e:
        print(f"  ✗ error during restore: {e}")
        return
    print(f"  ✓ '{name}' done")


def _cmux_available() -> bool:
    r = subprocess.run(["which", "cmux"], capture_output=True)
    return r.returncode == 0


def main() -> None:
    if not _cmux_available():
        print("Error: cmux CLI not found. Make sure cmux.app is installed.")
        sys.exit(1)

    if len(sys.argv) > 1:
        arg = sys.argv[1]
        # Path-traversal guard: a slash means treat as a path; otherwise validate name
        if "/" in arg:
            path = Path(arg)
        else:
            if not re.fullmatch(r"[A-Za-z0-9._\-]+", arg):
                print(f"Error: snapshot name contains disallowed characters: {arg!r}")
                sys.exit(1)
            path = SNAPSHOT_DIR / f"{arg}.json"
    else:
        snapshots = sorted(SNAPSHOT_DIR.glob("*.json"))
        if not snapshots:
            print("No snapshots found. Run cmux-snapshot first.")
            sys.exit(1)
        path = snapshots[-1]
        print(f"using latest snapshot: {path.name}")

    if not path.exists():
        print(f"Error: snapshot file not found: {path}")
        sys.exit(1)

    try:
        with open(path) as f:
            snapshot = json.load(f)
    except (json.JSONDecodeError, OSError) as e:
        print(f"Error: failed to parse snapshot: {e}")
        sys.exit(1)

    print(f"=== cmux-restore: {snapshot['name']} ({snapshot['timestamp'][:10]}) ===")
    print(f"restoring {len(snapshot['workspaces'])} workspaces...")
    print(f"(delay: {RESTORE_DELAY}s, override via CMUX_RESTORE_DELAY env var)")

    for ws in snapshot["workspaces"]:
        restore_workspace(ws)

    print("\n=== restore complete ===")
    print(run(["cmux", "list-workspaces"]))


if __name__ == "__main__":
    main()
