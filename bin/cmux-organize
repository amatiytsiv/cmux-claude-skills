#!/usr/bin/env zsh
# cmux-organize: classify a workspace's existing surfaces by topic and rearrange them into panes
# Usage: cmux-organize [workspace-ref]

set -euo pipefail

# ── Dependencies ─────────────────────────────────────────────
if ! command -v cmux &>/dev/null; then
  echo "Error: cmux CLI not found. Make sure cmux.app is installed."
  exit 1
fi

WORKSPACE="${1:-${CMUX_WORKSPACE_ID:-}}"

if [[ -z "$WORKSPACE" ]]; then
  echo "Usage: cmux-organize [workspace-ref]"
  echo "  Or run from inside a cmux workspace terminal (CMUX_WORKSPACE_ID is set automatically)."
  exit 1
fi

# ── Classification patterns ──────────────────────────────────
# Customize keywords via env vars (| separator):
#   CMUX_RESEARCH_KEYWORDS="research|deep.dive|survey"
#   CMUX_TOOLS_KEYWORDS="skill|plugin|hook|claude"
_RESEARCH_PAT="${CMUX_RESEARCH_KEYWORDS:-research|deep.dive|survey|analysis|reference|docs|learn}"
_TOOLS_PAT="${CMUX_TOOLS_KEYWORDS:-skill|rule|obsidian|kaizen|consistency|hook|plugin|setup|n8n|claude|hud|memory|tool}"

classify_surface() {
  local title
  title=$(echo "$1" | tr '[:upper:]' '[:lower:]')
  if echo "$title" | grep -qE "$_RESEARCH_PAT"; then
    echo "research"
  elif echo "$title" | grep -qE "$_TOOLS_PAT"; then
    echo "tools"
  else
    echo "work"
  fi
}

# ── Parse first pane + surface ───────────────────────────────
FIRST_PANE=$(cmux list-panes --workspace "$WORKSPACE" 2>/dev/null | grep -oE "pane:[0-9]+" | head -1)
if [[ -z "$FIRST_PANE" ]]; then
  echo "Error: could not find a pane in '$WORKSPACE'."
  exit 1
fi

PANE_COUNT=$(cmux list-panes --workspace "$WORKSPACE" 2>/dev/null | grep -cE "pane:[0-9]+" || true)
if [[ "$PANE_COUNT" -gt 1 ]]; then
  echo "Already has $PANE_COUNT panes. Workspace looks organized."
  exit 0
fi

echo "=== cmux-organize: $WORKSPACE ==="

WORK_SURFACES=()
RESEARCH_SURFACES=()
TOOLS_SURFACES=()

while IFS= read -r line; do
  [[ -z "$line" ]] && continue
  SURFACE=$(echo "$line" | grep -oE "surface:[0-9]+")
  [[ -z "$SURFACE" ]] && continue
  TITLE=$(echo "$line" | sed -E 's/[* ]*(surface:[0-9]+)[[:space:]]*//' | sed 's/\[selected\]//' | xargs)

  GROUP=$(classify_surface "$TITLE")
  case $GROUP in
    research) RESEARCH_SURFACES+=("$SURFACE") ;;
    tools)    TOOLS_SURFACES+=("$SURFACE") ;;
    *)        WORK_SURFACES+=("$SURFACE") ;;
  esac
  printf "  %-14s → [%-8s] %s\n" "$SURFACE" "$GROUP" "$TITLE"
done < <(cmux list-pane-surfaces --workspace "$WORKSPACE" --pane "$FIRST_PANE" 2>/dev/null)

echo ""
echo "  work     (${#WORK_SURFACES[@]}): ${WORK_SURFACES[*]:-none}"
echo "  research (${#RESEARCH_SURFACES[@]}): ${RESEARCH_SURFACES[*]:-none}"
echo "  tools    (${#TOOLS_SURFACES[@]}): ${TOOLS_SURFACES[*]:-none}"
echo ""

if [[ ${#RESEARCH_SURFACES[@]} -eq 0 && ${#TOOLS_SURFACES[@]} -eq 0 ]]; then
  echo "All surfaces classified as 'work'. Nothing to rearrange — exiting."
  exit 0
fi

# ── Step 1: create right pane → move research ────────────────
RESEARCH_PANE=""
if [[ ${#RESEARCH_SURFACES[@]} -gt 0 ]]; then
  echo "→ Moving research group to a right-side pane..."
  ANCHOR="${WORK_SURFACES[1]:-${RESEARCH_SURFACES[1]}}"

  BEFORE=$(cmux list-panes --workspace "$WORKSPACE" 2>/dev/null | grep -oE "pane:[0-9]+" | sort)
  SPLIT_OUT=$(cmux new-split right --workspace "$WORKSPACE" --surface "$ANCHOR" 2>/dev/null)
  AUTO_SURFACE=$(echo "$SPLIT_OUT" | grep -oE "surface:[0-9]+" || true)
  AFTER=$(cmux list-panes --workspace "$WORKSPACE" 2>/dev/null | grep -oE "pane:[0-9]+" | sort)
  RESEARCH_PANE=$(comm -13 <(echo "$BEFORE") <(echo "$AFTER") | head -1)

  for surf in "${RESEARCH_SURFACES[@]}"; do
    ERR=$(cmux move-surface --surface "$surf" --pane "$RESEARCH_PANE" 2>&1) && \
      echo "  moved: $surf → $RESEARCH_PANE (research)" || \
      echo "  Warning: failed to move $surf — $ERR"
  done

  [[ -n "$AUTO_SURFACE" ]] && cmux close-surface --surface "$AUTO_SURFACE" --workspace "$WORKSPACE" 2>/dev/null || true
fi

# ── Step 2: below the research pane → tools pane ─────────────
TOOLS_PANE=""
if [[ ${#TOOLS_SURFACES[@]} -gt 0 && -n "$RESEARCH_PANE" ]]; then
  echo "→ Moving tools/skills group to a pane below..."
  RESEARCH_ANCHOR="${RESEARCH_SURFACES[1]}"  # zsh: 1-indexed (first element)

  BEFORE=$(cmux list-panes --workspace "$WORKSPACE" 2>/dev/null | grep -oE "pane:[0-9]+" | sort)
  SPLIT_OUT=$(cmux new-split down --workspace "$WORKSPACE" --surface "$RESEARCH_ANCHOR" 2>/dev/null)
  AUTO_SURFACE=$(echo "$SPLIT_OUT" | grep -oE "surface:[0-9]+" || true)
  AFTER=$(cmux list-panes --workspace "$WORKSPACE" 2>/dev/null | grep -oE "pane:[0-9]+" | sort)
  TOOLS_PANE=$(comm -13 <(echo "$BEFORE") <(echo "$AFTER") | head -1)

  for surf in "${TOOLS_SURFACES[@]}"; do
    ERR=$(cmux move-surface --surface "$surf" --pane "$TOOLS_PANE" 2>&1) && \
      echo "  moved: $surf → $TOOLS_PANE (tools)" || \
      echo "  Warning: failed to move $surf — $ERR"
  done

  [[ -n "$AUTO_SURFACE" ]] && cmux close-surface --surface "$AUTO_SURFACE" --workspace "$WORKSPACE" 2>/dev/null || true
elif [[ ${#TOOLS_SURFACES[@]} -gt 0 && ${#WORK_SURFACES[@]} -gt 0 ]]; then
  # No research, only tools — anchor on a work surface and create a right pane
  # NOTE: skip if there are no work surfaces, otherwise the original pane goes empty
  echo "→ Moving tools group to a right-side pane..."
  ANCHOR="${WORK_SURFACES[1]}"  # zsh: 1-indexed; work guaranteed non-empty here

  BEFORE=$(cmux list-panes --workspace "$WORKSPACE" 2>/dev/null | grep -oE "pane:[0-9]+" | sort)
  SPLIT_OUT=$(cmux new-split right --workspace "$WORKSPACE" --surface "$ANCHOR" 2>/dev/null)
  AUTO_SURFACE=$(echo "$SPLIT_OUT" | grep -oE "surface:[0-9]+" || true)
  AFTER=$(cmux list-panes --workspace "$WORKSPACE" 2>/dev/null | grep -oE "pane:[0-9]+" | sort)
  TOOLS_PANE=$(comm -13 <(echo "$BEFORE") <(echo "$AFTER") | head -1)

  for surf in "${TOOLS_SURFACES[@]}"; do
    ERR=$(cmux move-surface --surface "$surf" --pane "$TOOLS_PANE" 2>&1) && \
      echo "  moved: $surf → $TOOLS_PANE (tools)" || \
      echo "  Warning: failed to move $surf — $ERR"
  done

  [[ -n "$AUTO_SURFACE" ]] && cmux close-surface --surface "$AUTO_SURFACE" --workspace "$WORKSPACE" 2>/dev/null || true
elif [[ ${#TOOLS_SURFACES[@]} -gt 0 ]]; then
  echo "  Info: no work surfaces — skipping tools split (would leave the original pane empty)."
fi

echo ""
echo "=== done ==="
cmux tree --workspace "$WORKSPACE" 2>/dev/null || true
