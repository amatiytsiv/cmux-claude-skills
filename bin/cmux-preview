#!/usr/bin/env zsh
# cmux-preview: live-preview a markdown file in a side panel
# Usage: cmux-preview <file.md>

set -euo pipefail

if ! command -v cmux &>/dev/null; then
  echo "Error: cmux CLI not found. Make sure cmux.app is installed."
  exit 1
fi

FILE="${1:-}"

if [[ -z "$FILE" || "$FILE" == "--help" || "$FILE" == "-h" ]]; then
  echo "Usage: cmux-preview <file.md>"
  echo "  Open a markdown file in cmux's side panel as a live preview."
  exit 0
fi

# Convert to absolute path
FILE=$(realpath "$FILE" 2>/dev/null || echo "$PWD/$FILE")

if [[ ! -f "$FILE" ]]; then
  echo "Error: file not found → $FILE"
  exit 1
fi

echo "Opening markdown viewer: $FILE"
cmux markdown open "$FILE"
